# Discord Bot Configuration (Required)
BOT_TOKEN=your_discord_bot_token_here
OWNER_ID=your_discord_user_id_here

# Weather Command - OpenWeatherMap API
# Get a free key at: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key

# Meme Command - Imgflip API
# Create a free account at: https://imgflip.com/signup
IMGFLIP_USERNAME=your_imgflip_username
IMGFLIP_PASSWORD=your_imgflip_password

# Xbox Live Command - OpenXBL API
# Get a key at: https://xbl.io/
OPENXBL_API_KEY=your_openxbl_api_key

# YouTube Command - YouTube Data API v3
# Get a key at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key
